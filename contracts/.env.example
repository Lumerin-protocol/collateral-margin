# ── RPC ────────────────────────────────────────────────────────────────────
# Used to build the Base Sepolia / Base Mainnet RPC URLs:
#   https://base-{sepolia,mainnet}.g.alchemy.com/v2/$ALCHEMY_API_KEY
ALCHEMY_API_KEY=

# ── Deployer ──────────────────────────────────────────────────────────────
# Hex-encoded private key used as the deployer for `--network base-sepolia` and
# `--network base-mainnet`. Not required for `localhost` / `hardhat` networks.
PRIVATE_KEY=

# ── Block explorer verification ───────────────────────────────────────────
# Etherscan v2 API key (works for BaseScan via Etherscan multichain).
ETHERSCAN_API_KEY=

# ── Optional, used by both deploy scripts ─────────────────────────────────
# If set, the deployed contract's ownership is transferred to this address as
# the last step of the script.
SAFE_OWNER_ADDRESS=

# ── deploy-collateral-vault.ts ────────────────────────────────────────────
# ERC20 the vault custodies.
COLLATERAL_TOKEN_ADDRESS=

# ── deploy-portfolio-margin-engine.ts / update-collateral-vault.ts ────────
# Address of the already-deployed CollateralVault (ERC1967 proxy).
# `update-collateral-vault.ts` upgrades this proxy to a freshly-deployed impl.
VAULT_ADDRESS=

# ── update-portfolio-margin-engine.ts ─────────────────────────────────────
# Address of the already-deployed PortfolioMarginEngine (ERC1967 proxy).
PME_ADDRESS=

# Optional. Pre-existing product engines to register on the PME and authorize
# on the vault. Leave unset to skip a leg. Vault wiring runs only if the
# deployer is still the vault owner; otherwise the script prints the calldata
# that the current vault owner (typically a Safe) must execute.
PERPS_ADDRESS=
OPTIONS_ENGINE_ADDRESS=
FUTURES_ADDRESS=

# Optional stress-shock overrides (WAD-scaled, e.g. 0.1e18 = 100000000000000000).
# Any unset value keeps the contract default set in initialize().
IM_SPOT_SHOCK=
MM_SPOT_SHOCK=
IM_VOL_SHOCK=
MM_VOL_SHOCK=
