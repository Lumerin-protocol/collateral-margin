# ── Subgraph manifest ──────────────────────────────────────────────────────
NETWORK=arbitrum-sepolia
VAULT_ADDRESS=0x0000000000000000000000000000000000000000
VAULT_START_BLOCK=0

# Authorized engine addresses, exposed to mappings via the data source `context`
# block in subgraph.template.yaml. Used to bucket internal Transfer events into
# PERPS / OPTIONS / OTHER.
PERPS_ADDRESS=0x0000000000000000000000000000000000000000
OPTIONS_ADDRESS=0x0000000000000000000000000000000000000000

# ── docker-compose (graph-node) ────────────────────────────────────────────
ETH_NODE_ADDRESS=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
